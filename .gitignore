# OS / editor cruft
**/.DS_Store

# Jekyll build caches
.sass-cache
.jekyll-cache
.jekyll-metadata

# Build dependency dirs
node_modules/
kipukas-server/target/
kipukas-server/target-plain/

# Local state of the relay when run with `deno task dev` in signaling-server/
.wrangler/

# Generated build outputs — built locally by `deno task build` and published to
# the gh-pages branch via `deno task deploy`. Never committed to master.
_site/
game_rules/
sw.js
assets/css/output.css
assets/js-wasm/kipukas-server-pkg/
assets/js/alpine.bundle.min.js
assets/js-wasm/onnxruntime-web-*/

# The ONNX Runtime Web release those files are taken from, kept so that it is
# fetched once (scripts/fetch-onnxruntime.ts)
.cache/

# Archived experiment — kept locally for reference; the compressed copy is in
# .archive/yolo-rqrr-experiment.tar.gz (committed).
YOLO_rqrr/
runs/

# Kippa's server (a copy of LLMvp). Company owned and not part of this
# repository: it stays on the machine that runs it.
llmvp/

# Misc generated intermediaries
scripts/_alpine-entry.ts
new_extensions.txt

# The QR reader's build: fetched source and build output (zxing-reader/build.sh)
zxing-reader/.work/
