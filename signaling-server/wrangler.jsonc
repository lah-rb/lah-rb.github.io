{
  // The Kipukas relay: a Cloudflare Worker with one Durable Object per room.
  // How to run it locally and deploy it: CONTRIBUTING.md, "The relay".
  "name": "kipukas-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",

  // The address the site connects to (the site's engine holds the same name:
  // RELAY in kipukas-server/src/game/connection.rs). Cloudflare creates the
  // DNS record on deploy; the zone must be in the account being deployed to.
  "routes": [{ "pattern": "signal.kipukas.us", "custom_domain": true }],

  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // The free plan offers SQLite-backed Durable Objects only.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  "vars": {
    // Pages allowed to use the relay from a browser. Local copies of the site
    // (localhost and private network addresses) are always allowed.
    "ALLOWED_ORIGINS": "https://www.kipukas.cards,https://kipukas.cards",
    // How long a room with nobody connected is kept: 12 hours.
    "ROOM_TTL_SECONDS": "43200"
  }
}
